<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="24dp">

    <!-- হেডিং -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculation History"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="16dp"/>

    <!-- হিস্ট্রি লিস্ট (স্ক্রল করার জন্য) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <!-- Java থেকে এখানে ডাটা বসবে -->
        </LinearLayout>
    </ScrollView>

    <!-- যদি হিস্ট্রি খালি থাকে -->
    <TextView
        android:id="@+id/tvEmptyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No calculation history yet."
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"/>

    <!-- বাটন এরিয়া -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="24dp">

        <TextView
            android:id="@+id/btnClearHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLEAR"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnShareHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHARE"
            android:textStyle="bold"
            android:textColor="@color/btn_orange_bg"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/btnCloseHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLOSE"
            android:textStyle="bold"
            android:textColor="@color/btn_orange_bg"
            android:padding="12dp"/>
    </LinearLayout>

</LinearLayout>