<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- ================= DISPLAY AREA ================= -->

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnHistory"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="14dp"
        android:text="↺"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:background="@drawable/btn_history"
        android:backgroundTint="@null"
        android:padding="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:textColor="@color/text_secondary"
        android:textSize="25sp"
        android:gravity="end"
        android:maxLines="1"
        android:ellipsize="start"
        app:layout_constraintBottom_toTopOf="@id/tvDisplay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="24dp"
        android:background="@null"
        android:cursorVisible="true"
        android:focusable="true"
        android:gravity="center_vertical|end"
        android:inputType="none"
        android:maxLines="1"
        android:padding="0dp"
        android:singleLine="true"
        android:text="0"
        android:textColor="@color/text_primary"
        android:textSize="58sp"
        app:layout_constraintBottom_toTopOf="@id/keypad"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ================= KEYPAD ================= -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/keypad"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintWidth_default="spread"
        app:layout_constraintDimensionRatio="4:5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ================= ROW 1 (AC, (), %, ÷) ================= -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="AC"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="25sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_light"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/btn7"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnBracket"
            app:layout_constraintVertical_weight="1"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBracket"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="( )"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="25sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_light"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btnClear"
            app:layout_constraintBottom_toBottomOf="@id/btnClear"
            app:layout_constraintStart_toEndOf="@id/btnClear"
            app:layout_constraintEnd_toStartOf="@id/btnPercent"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPercent"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="%"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="25sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_light"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btnClear"
            app:layout_constraintBottom_toBottomOf="@id/btnClear"
            app:layout_constraintStart_toEndOf="@id/btnBracket"
            app:layout_constraintEnd_toStartOf="@id/btnDivide"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDivide"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="÷"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_orange"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btnClear"
            app:layout_constraintBottom_toBottomOf="@id/btnClear"
            app:layout_constraintStart_toEndOf="@id/btnPercent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"/>

        <!-- ================= ROW 2 (7, 8, 9, ×) ================= -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="7"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/btnClear"
            app:layout_constraintBottom_toTopOf="@id/btn4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn8"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="8"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn7"
            app:layout_constraintBottom_toBottomOf="@id/btn7"
            app:layout_constraintStart_toEndOf="@id/btn7"
            app:layout_constraintEnd_toStartOf="@id/btn9"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="9"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn7"
            app:layout_constraintBottom_toBottomOf="@id/btn7"
            app:layout_constraintStart_toEndOf="@id/btn8"
            app:layout_constraintEnd_toStartOf="@id/btnMultiply"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMultiply"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="×"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_orange"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn7"
            app:layout_constraintBottom_toBottomOf="@id/btn7"
            app:layout_constraintStart_toEndOf="@id/btn9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"/>

        <!-- ================= ROW 3 (4, 5, 6, −) ================= -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="4"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/btn7"
            app:layout_constraintBottom_toTopOf="@id/btn1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn5"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="5"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn4"
            app:layout_constraintBottom_toBottomOf="@id/btn4"
            app:layout_constraintStart_toEndOf="@id/btn4"
            app:layout_constraintEnd_toStartOf="@id/btn6"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="6"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn4"
            app:layout_constraintBottom_toBottomOf="@id/btn4"
            app:layout_constraintStart_toEndOf="@id/btn5"
            app:layout_constraintEnd_toStartOf="@id/btnMinus"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMinus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="−"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_orange"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn4"
            app:layout_constraintBottom_toBottomOf="@id/btn4"
            app:layout_constraintStart_toEndOf="@id/btn6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"/>

        <!-- ================= ROW 4 (1, 2, 3, +) ================= -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="1"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/btn4"
            app:layout_constraintBottom_toTopOf="@id/btn0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn2"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="2"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn1"
            app:layout_constraintBottom_toBottomOf="@id/btn1"
            app:layout_constraintStart_toEndOf="@id/btn1"
            app:layout_constraintEnd_toStartOf="@id/btn3"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="3"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn1"
            app:layout_constraintBottom_toBottomOf="@id/btn1"
            app:layout_constraintStart_toEndOf="@id/btn2"
            app:layout_constraintEnd_toStartOf="@id/btnPlus"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPlus"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="+"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_orange"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn1"
            app:layout_constraintBottom_toBottomOf="@id/btn1"
            app:layout_constraintStart_toEndOf="@id/btn3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"/>

        <!-- ================= ROW 5 (0, ., ⌫, =) ================= -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn0"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="0"
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="24sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toBottomOf="@id/btn1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnDot"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="."
            android:textStyle="bold"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="28sp"
            android:textColor="@color/text_primary"
            android:background="@drawable/btn_dark"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn0"
            app:layout_constraintBottom_toBottomOf="@id/btn0"
            app:layout_constraintStart_toEndOf="@id/btn0"
            app:layout_constraintEnd_toStartOf="@id/btnBackspace"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBackspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="⌫"
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="16sp"
            app:autoSizeMaxTextSize="25sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_dark_wide"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn0"
            app:layout_constraintBottom_toBottomOf="@id/btn0"
            app:layout_constraintStart_toEndOf="@id/btnDot"
            app:layout_constraintEnd_toStartOf="@id/btnEqual"
            app:layout_constraintDimensionRatio="1:1"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEqual"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="="
            app:autoSizeTextType="uniform"
            app:autoSizeMinTextSize="18sp"
            app:autoSizeMaxTextSize="28sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/equal_btn"
            android:padding="0dp"
            app:layout_constraintTop_toTopOf="@id/btn0"
            app:layout_constraintBottom_toBottomOf="@id/btn0"
            app:layout_constraintStart_toEndOf="@id/btnBackspace"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintDimensionRatio="1:1"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>